# ==============================================================================
# WORKPULSE AI — CLIENT (VITE STATIC SITE) ENVIRONMENT VARIABLES
# ==============================================================================
# In production on Render Static Site, configure these in the Render Dashboard Environment tab.
# Note: Vite inlines VITE_* variables into client bundle at build time.
# NEVER place private secret keys or database credentials in client env!
# ==============================================================================

# Backend API endpoint (with /api suffix)
# On Render: https://YOUR-BACKEND-SERVICE.onrender.com/api
# On Localhost: leave empty to use local Vite proxy (/api)
VITE_API_URL=https://your-backend-service.onrender.com/api

# Backend Socket.IO cluster URL (root URL without /api or trailing slash)
# On Render: https://YOUR-BACKEND-SERVICE.onrender.com
# On Localhost: leave empty to default to window.location.origin
VITE_SOCKET_URL=https://your-backend-service.onrender.com
