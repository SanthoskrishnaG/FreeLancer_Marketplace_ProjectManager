{
  "name": "freelancer-marketplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Freelancer Marketplace and Project Management Platform",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "start:server": "npm run start --workspace=server",
    "dev": "concurrently -k --names \"server,client\" -c \"blue,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run db:generate --workspace=server",
    "test": "npm test --workspace=server",
    "seed": "npm run seed --workspace=server",
    "db:seed": "npm run seed --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "admin:django": "python django-admin/manage.py runserver 8000"
  },
  "keywords": [
    "freelancer",
    "marketplace",
    "project-management",
    "ai",
    "milestones",
    "socketio",
    "javascript"
  ],
  "author": "Full Stack Architect",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "cloudinary": "^2.11.0"
  }
}
