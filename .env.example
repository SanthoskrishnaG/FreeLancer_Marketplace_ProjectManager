# ==============================================================================
# WORKPULSE AI — PRODUCTION & LOCAL ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# DO NOT commit real secrets or credentials to source control.
# Copy this file to .env in your local environment or configure in the Render Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (Render Web Service)
# ------------------------------------------------------------------------------
# Environment mode ('production' on Render, 'development' on localhost)
NODE_ENV=production

# Server port (assigned automatically by Render, default 5000 locally)
PORT=5000

# PostgreSQL Connection String
# On Render: Use the "Internal Database URL" (e.g., postgresql://user:pass@dpg-xxx-a:5432/dbname)
# On Localhost: postgresql://postgres:postgrespassword@localhost:5432/freelancer_marketplace?schema=public
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?schema=public

# Allowed Frontend URL for CORS and Socket.IO
# On Render: https://YOUR-FRONTEND-STATIC-SITE.onrender.com (without trailing slash)
# On Localhost: http://localhost:5173
CLIENT_URL=https://your-frontend-service.onrender.com

# Backend Public Base URL
# On Render: https://YOUR-BACKEND-WEB-SERVICE.onrender.com
# On Localhost: http://localhost:5000
SERVER_URL=https://your-backend-service.onrender.com

# JWT Authentication Secrets (Generate strong random 64-char strings for production)
JWT_SECRET=generate_a_secure_random_64_character_jwt_secret_for_production
JWT_REFRESH_SECRET=generate_a_secure_random_64_character_refresh_secret_for_production

# ------------------------------------------------------------------------------
# 2. AI SERVICES (Milestone Decomposition & Requirement Analysis)
# ------------------------------------------------------------------------------
# Primary Provider: Groq LPU (Ultra-fast inference via openai/gpt-oss-120b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary / Alternative Provider: OpenAI
# Optional fallback if GROQ_API_KEY is not set. If both are empty, Mock AI engine is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. OPTIONAL THIRD-PARTY INTEGRATIONS
# ------------------------------------------------------------------------------
# Cloudinary (Media & deliverable storage; falls back to local disk uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Escrow payment processing; falls back to internal mock escrow if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend Email (Transactional notifications; falls back to console logger if empty)
RESEND_API_KEY=
EMAIL_FROM=notifications@marketplace.io

# ------------------------------------------------------------------------------
# 4. FRONTEND BUILD CONFIGURATION (Render Static Site)
# ------------------------------------------------------------------------------
# Backend API Base URL (used at build time by Vite)
# Example: https://YOUR-BACKEND-WEB-SERVICE.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# Socket.IO Realtime WebSocket URL (used at build time by Vite)
# Example: https://YOUR-BACKEND-WEB-SERVICE.onrender.com
VITE_SOCKET_URL=https://your-backend-service.onrender.com
