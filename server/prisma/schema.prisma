// Prisma schema for Freelancer Marketplace (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  FREELANCER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  ARCHIVED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  RELEASED
  CANCELLED
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  TERMINATED
  DISPUTED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum NotificationType {
  SYSTEM
  MESSAGE
  PROPOSAL
  MILESTONE
  CONTRACT
  PAYMENT
  DISPUTE
  REVIEW
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  STATUS_CHANGE
}

// ----------------------------------------------------
// Core User & Profiles
// ----------------------------------------------------

model User {
  id                    String             @id @default(uuid())
  email                 String             @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  UserRole           @default(CLIENT)
  isVerified            Boolean            @default(false)
  verificationToken     String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  refreshToken          String?
  avatarUrl             String?
  phoneNumber           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relationships
  clientProfile         ClientProfile?
  freelancerProfile     FreelancerProfile?
  sentMessages          Message[]          @relation("SentMessages")
  receivedMessages      Message[]          @relation("ReceivedMessages")
  notifications         Notification[]
  writtenReviews        Review[]           @relation("WrittenReviews")
  receivedReviews       Review[]           @relation("ReceivedReviews")
  disputesInitiated     Dispute[]          @relation("InitiatedDisputes")
  uploadedFiles         File[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([role])
}

model ClientProfile {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String?
  companyWebsite String?
  description    String?
  country        String?
  totalSpent     Decimal    @default(0.00) @db.Decimal(12, 2)
  rating         Decimal    @default(0.00) @db.Decimal(3, 2)
  reviewCount    Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relationships
  projects       Project[]
  contracts      Contract[]

  @@index([userId])
}

model FreelancerProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  bio             String?
  hourlyRate      Decimal?          @db.Decimal(10, 2)
  experienceYears Int?              @default(0)
  country         String?
  totalEarned     Decimal           @default(0.00) @db.Decimal(12, 2)
  rating          Decimal           @default(0.00) @db.Decimal(3, 2)
  reviewCount     Int               @default(0)
  isAvailable     Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  skills          FreelancerSkill[]
  proposals       Proposal[]
  contracts       Contract[]

  @@index([userId])
}

// ----------------------------------------------------
// Categories & Skills
// ----------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("SubCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  skills      Skill[]
  projects    Project[]

  @@index([slug])
  @@index([parentId])
}

model Skill {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relationships
  freelancers FreelancerSkill[]
  projects    ProjectSkill[]

  @@index([slug])
  @@index([categoryId])
}

model FreelancerSkill {
  id                  String            @id @default(uuid())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skillId             String
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency         String?           // Beginner, Intermediate, Expert
  createdAt           DateTime          @default(now())

  @@unique([freelancerProfileId, skillId])
  @@index([freelancerProfileId])
  @@index([skillId])
}

// ----------------------------------------------------
// Projects, Milestones & Proposals
// ----------------------------------------------------

model Project {
  id              String         @id @default(uuid())
  clientId        String
  client          ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title           String
  description     String
  budget          Decimal        @db.Decimal(12, 2)
  budgetType      String         @default("FIXED") // FIXED or HOURLY
  status          ProjectStatus  @default(DRAFT)
  deadline        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  skills          ProjectSkill[]
  proposals       Proposal[]
  milestones      Milestone[]
  contracts       Contract[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
}

model ProjectSkill {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relationships
  invoices    Invoice[]

  @@index([projectId])
  @@index([contractId])
  @@index([status])
}

model Proposal {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  coverLetter         String
  bidAmount           Decimal           @db.Decimal(12, 2)
  estimatedDuration   String?
  status              ProposalStatus    @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([projectId, freelancerProfileId])
  @@index([projectId])
  @@index([freelancerProfileId])
  @@index([status])
}

// ----------------------------------------------------
// Contracts, Invoices, Reviews & Disputes
// ----------------------------------------------------

model Contract {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId            String
  client              ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  status              ContractStatus    @default(ACTIVE)
  totalAmount         Decimal           @db.Decimal(12, 2)
  startDate           DateTime          @default(now())
  endDate             DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relationships
  milestones          Milestone[]
  messages            Message[]
  invoices            Invoice[]
  reviews             Review[]
  disputes            Dispute[]

  @@index([projectId])
  @@index([clientId])
  @@index([freelancerProfileId])
  @@index([status])
}

model Invoice {
  id          String        @id @default(uuid())
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  amount      Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contractId])
  @@index([milestoneId])
  @@index([status])
}

model Review {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("WrittenReviews", fields: [authorId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ReceivedReviews", fields: [recipientId], references: [id], onDelete: Cascade)
  rating      Int      // 1 to 5 stars
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contractId, authorId])
  @@index([contractId])
  @@index([authorId])
  @@index([recipientId])
}

model Dispute {
  id          String        @id @default(uuid())
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  initiatorId String
  initiator   User          @relation("InitiatedDisputes", fields: [initiatorId], references: [id], onDelete: Cascade)
  reason      String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contractId])
  @@index([initiatorId])
  @@index([status])
}

// ----------------------------------------------------
// Communication, Files & System Auditing
// ----------------------------------------------------

model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  content     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([contractId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model File {
  id         String   @id @default(uuid())
  key        String   @unique
  url        String
  filename   String
  mimeType   String
  size       Int
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  entityType String?  // e.g., 'PROJECT', 'PORTFOLIO', 'AVATAR', 'CONTRACT'
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([uploaderId])
  @@index([entityType, entityId])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String      // e.g., 'User', 'Contract', 'Project'
  entityId  String?
  details   String?     // JSON details or description
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
}
