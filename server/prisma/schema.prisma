// Prisma schema for Freelancer Marketplace (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  FREELANCER
  ADMIN
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  ARCHIVED
}

enum ProposalStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  COMPLETED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum NotificationType {
  SYSTEM
  MESSAGE
  PROPOSAL
  MILESTONE
  CONTRACT
  PAYMENT
  DISPUTE
  REVIEW
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  STATUS_CHANGE
}

// ----------------------------------------------------
// Core User & Profiles
// ----------------------------------------------------

model User {
  id                    String             @id @default(uuid())
  email                 String             @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  UserRole           @default(CLIENT)
  isVerified            Boolean            @default(false)
  verificationToken     String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  refreshToken          String?
  avatarUrl             String?
  phoneNumber           String?
  location              String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relationships
  clientProfile         ClientProfile?
  freelancerProfile     FreelancerProfile?
  sentMessages          Message[]          @relation("SentMessages")
  notifications         Notification[]
  writtenReviews        Review[]           @relation("WrittenReviews")
  receivedReviews       Review[]           @relation("ReceivedReviews")
  disputesInitiated     Dispute[]          @relation("InitiatedDisputes")
  uploadedFiles         File[]
  auditLogs             AuditLog[]
  bookmarks             Bookmark[]
  conversations         ConversationParticipant[]

  @@index([email])
  @@index([role])
}

model ClientProfile {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String?
  companyWebsite String?
  logoUrl        String?
  description    String?
  industry       String?
  country        String?
  totalSpent     Decimal    @default(0.00) @db.Decimal(12, 2)
  rating         Decimal    @default(0.00) @db.Decimal(3, 2)
  reviewCount    Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relationships
  projects       Project[]
  contracts      Contract[]

  @@index([userId])
  @@index([companyName])
}

model FreelancerProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  bio             String?
  hourlyRate      Decimal?          @db.Decimal(10, 2)
  experienceYears Int?              @default(0)
  experienceLevel ExperienceLevel   @default(INTERMEDIATE)
  country         String?
  languages       String[]          @default(["English"])
  portfolio       Json?             // Array of { title, description, url, imageUrl }
  totalEarned     Decimal           @default(0.00) @db.Decimal(12, 2)
  rating          Decimal           @default(0.00) @db.Decimal(3, 2)
  reviewCount     Int               @default(0)
  isAvailable     Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  skills          FreelancerSkill[]
  proposals       Proposal[]
  contracts       Contract[]
  submissions     MilestoneSubmission[]

  @@index([userId])
  @@index([isAvailable])
  @@index([experienceLevel])
  @@index([rating])
}

// ----------------------------------------------------
// Categories & Skills
// ----------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("SubCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  skills      Skill[]
  projects    Project[]

  @@index([slug])
  @@index([parentId])
}

model Skill {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relationships
  freelancers FreelancerSkill[]
  projects    ProjectSkill[]

  @@index([slug])
  @@index([categoryId])
}

model FreelancerSkill {
  id                  String            @id @default(uuid())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skillId             String
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency         String?           // Beginner, Intermediate, Expert
  createdAt           DateTime          @default(now())

  @@unique([freelancerProfileId, skillId])
  @@index([freelancerProfileId])
  @@index([skillId])
}

// ----------------------------------------------------
// Projects, Milestones & Proposals
// ----------------------------------------------------

model Project {
  id              String           @id @default(uuid())
  clientId        String
  client          ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title           String
  description     String
  requirements    String?
  budget          Decimal          @db.Decimal(12, 2)
  minBudget       Decimal?         @db.Decimal(12, 2)
  maxBudget       Decimal?         @db.Decimal(12, 2)
  budgetType      String           @default("FIXED") // FIXED or HOURLY
  experienceLevel ExperienceLevel @default(INTERMEDIATE)
  status          ProjectStatus    @default(DRAFT)
  deadline        DateTime?
  attachments     Json?            // Array of file metadata
  proposalCount   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  skills          ProjectSkill[]
  proposals       Proposal[]
  milestones      Milestone[]
  contracts       Contract[]
  bookmarks       Bookmark[]
  conversations   Conversation[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
  @@index([experienceLevel])
  @@index([budget])
  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model ProjectSkill {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
}

model Milestone {
  id                 String          @id @default(uuid())
  projectId          String?
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId         String?
  contract           Contract?       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  deliverables       String[]        @default([])
  estimatedDuration  String?
  budgetPercentage   Decimal?        @db.Decimal(5, 2)
  dependencies       String[]        @default([])
  acceptanceCriteria String[]        @default([])
  order              Int             @default(0)
  amount             Decimal         @db.Decimal(12, 2)
  status             MilestoneStatus @default(PENDING)
  dueDate            DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relationships
  invoices           Invoice[]
  submissions        MilestoneSubmission[]
  revisions          MilestoneRevision[]

  @@index([projectId])
  @@index([contractId])
  @@index([status])
  @@index([order])
}

model MilestoneSubmission {
  id                  String            @id @default(uuid())
  milestoneId         String
  milestone           Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  description         String
  notes               String?
  links               String[]          @default([])
  submittedAt         DateTime          @default(now())

  // Relationships
  files               File[]
  revisions           MilestoneRevision[]

  @@index([milestoneId])
  @@index([freelancerProfileId])
  @@index([submittedAt])
}

model MilestoneRevision {
  id                  String              @id @default(uuid())
  milestoneId         String
  milestone           Milestone           @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submissionId        String?
  submission          MilestoneSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  feedback            String
  requestedChanges    String[]            @default([])
  dueDate             DateTime?
  createdAt           DateTime            @default(now())

  @@index([milestoneId])
  @@index([submissionId])
}

model Proposal {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  coverLetter         String
  bidAmount           Decimal           @db.Decimal(12, 2)
  estimatedDuration   String?
  milestonePricing    Json?             // Array of { title, amount, duration }
  attachments         Json?             // Array of file URLs
  status              ProposalStatus    @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relationships
  contract            Contract?

  @@unique([projectId, freelancerProfileId])
  @@index([projectId])
  @@index([freelancerProfileId])
  @@index([status])
  @@index([projectId, status])
}

// ----------------------------------------------------
// Contracts, Invoices, Reviews & Disputes
// ----------------------------------------------------

model Contract {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId          String?           @unique
  proposal            Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  clientId            String
  client              ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  status              ContractStatus    @default(ACTIVE)
  totalAmount         Decimal           @db.Decimal(12, 2)
  startDate           DateTime          @default(now())
  endDate             DateTime?
  terms               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relationships
  milestones          Milestone[]
  invoices            Invoice[]
  reviews             Review[]
  disputes            Dispute[]
  conversation        Conversation?

  @@unique([projectId, freelancerProfileId])
  @@index([projectId])
  @@index([clientId])
  @@index([freelancerProfileId])
  @@index([status])
}

model Invoice {
  id          String        @id @default(uuid())
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  amount      Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contractId])
  @@index([milestoneId])
  @@index([status])
}

model Review {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("WrittenReviews", fields: [authorId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ReceivedReviews", fields: [recipientId], references: [id], onDelete: Cascade)
  rating      Int      // 1 to 5 stars
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contractId, authorId])
  @@index([contractId])
  @@index([authorId])
  @@index([recipientId])
}

model Dispute {
  id          String        @id @default(uuid())
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  initiatorId String
  initiator   User          @relation("InitiatedDisputes", fields: [initiatorId], references: [id], onDelete: Cascade)
  reason      String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contractId])
  @@index([initiatorId])
  @@index([status])
}

// ----------------------------------------------------
// Real-Time Chat & Messaging
// ----------------------------------------------------

model Conversation {
  id           String                    @id @default(uuid())
  contractId   String?                   @unique
  contract     Contract?                 @relation(fields: [contractId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  // Relationships
  participants ConversationParticipant[]
  messages     Message[]

  @@index([contractId])
  @@index([projectId])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // Relationships
  files          File[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model File {
  id                    String               @id @default(uuid())
  originalName          String
  storageKey            String               @unique
  url                   String
  mimeType              String
  size                  Int
  uploaderId            String
  uploader              User                 @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  entityType            String?              // 'PORTFOLIO', 'PROJECT', 'MILESTONE', 'CHAT', 'DISPUTE'
  entityId              String?
  milestoneSubmissionId String?
  milestoneSubmission   MilestoneSubmission? @relation(fields: [milestoneSubmissionId], references: [id], onDelete: SetNull)
  messageId             String?
  message               Message?             @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())

  @@index([uploaderId])
  @@index([entityType, entityId])
  @@index([milestoneSubmissionId])
  @@index([messageId])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String      // e.g., 'User', 'Contract', 'Project'
  entityId  String?
  details   String?     // JSON details or description
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
}
