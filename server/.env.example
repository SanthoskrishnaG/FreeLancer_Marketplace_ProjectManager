# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancer_marketplace?schema=public"

# JWT Secrets (Use strong random strings in production)
JWT_ACCESS_SECRET="dev_access_secret_change_me_in_production_123456789"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me_in_production_987654321"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
