# ==============================================================================
# WORKPULSE AI — SERVER (EXPRESS WEB SERVICE) ENVIRONMENT VARIABLES
# ==============================================================================
# Set these variables in the Render Web Service Environment settings.
# NEVER commit real credentials to source control.
# ==============================================================================

# Runtime environment (production / development)
NODE_ENV=production

# Server Port (Render sets this dynamically, default 5000)
PORT=5000

# PostgreSQL Connection String
# On Render: Use the "Internal Database URL" of your Render PostgreSQL service
# Format: postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DB_NAME?schema=public
DATABASE_URL=postgresql://user:password@hostname:5432/freelancer_marketplace?schema=public

# Allowed Frontend URL for CORS and Socket.IO
# On Render: Use your Render Static Site URL (no trailing slash)
# Localhost: http://localhost:5173
CLIENT_URL=https://your-frontend-service.onrender.com

# Backend Public Origin
SERVER_URL=https://your-backend-service.onrender.com

# JWT Authentication Secrets (Use strong random strings in production)
JWT_SECRET=replace_with_strong_random_jwt_secret_for_production
JWT_REFRESH_SECRET=replace_with_strong_random_jwt_refresh_secret_for_production

# Groq LPU Configuration (Fast AI requirement analysis & milestone generation)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI API Key (Alternative AI provider fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudinary Storage (Optional, falls back to local disk storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payments (Optional, falls back to mock payment provider if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend Email (Optional, falls back to console email logger if empty)
RESEND_API_KEY=
EMAIL_FROM=notifications@marketplace.io
