# Database Connection String (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/freelancer_marketplace?schema=public

# Port & URLs
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=supersecret_jwt_key_for_development_purposes_only
JWT_REFRESH_SECRET=supersecret_refresh_jwt_key_for_development_purposes_only

# Groq API Configuration (Fast LPU inference for AI requirement analysis & milestone generation)
# Primary AI provider; if not provided, the server checks OPENAI_API_KEY, then falls back to Mock engine
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI API Key (Alternative AI provider)
# If missing, system gracefully falls back to the internal Mock AI service
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudinary Storage (Optional, falls back to local uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payments (Optional, falls back to internal Mock Payment Provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend Email (Optional, falls back to console email logger)
RESEND_API_KEY=
EMAIL_FROM=notifications@marketplace.io
